<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mes.modules.system.mapper.SysOperationLogMapper">

    <resultMap id="BaseResultMap" type="SysOperationLog">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="operation" column="operation"/>
        <result property="method" column="method"/>
        <result property="params" column="params"/>
        <result property="ip" column="ip"/>
        <result property="status" column="status"/>
        <result property="errorMsg" column="error_msg"/>
        <result property="duration" column="duration"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="BaseColumns">
        id, user_id, username, operation, method, params, ip,
        status, error_msg, duration, create_time
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_operation_log (user_id, username, operation, method, params,
                                       ip, status, error_msg, duration)
        VALUES (#{userId}, #{username}, #{operation}, #{method}, #{params},
                #{ip}, #{status}, #{errorMsg}, #{duration})
    </insert>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_operation_log
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countList" resultType="long">
        SELECT COUNT(*)
        FROM sys_operation_log
    </select>

</mapper>
